# ============================================================
# docker-compose.no-nginx.yml
#
# 不使用容器 Nginx，改由主機 Nginx 反向代理 Flask。
#
# 使用方式：
#   cp docker-compose.no-nginx.yml.sample docker-compose.no-nginx.yml
#   docker compose -f docker-compose.no-nginx.yml up -d
#
# 主機 Nginx 設定請參考 conf/nginx/host/ 下的範本：
#   http.conf                純 HTTP
#   cloudflare.conf          Cloudflare Origin CA SSL
#   https-letsencrypt.conf   Let's Encrypt SSL
# ============================================================

services:
  app:
    build:
      context: .
      dockerfile: docker/Dockerfile
    image: python-flask-api:latest
    hostname: flask-api
    env_file: .env
    environment:
      FLASK_PORT: "${FLASK_PORT:-5000}"
    ports:
      # 只綁定 127.0.0.1，讓主機 Nginx 連入；不對外直接暴露
      - "127.0.0.1:${FLASK_PORT:-5000}:${FLASK_PORT:-5000}"
    volumes:
      - ./app:/app/app
      - ./src:/app/src
      - ./run.py:/app/run.py
      - ./conf:/app/conf
      - ./logs:/app/logs
    depends_on:
      - mongo
      - mysql
      - redis
    restart: unless-stopped

  mongo:
    image: mongo:7
    hostname: flask-api-mongo
    volumes:
      - ./docker/database/mongo:/data/db
    restart: unless-stopped

  mysql:
    image: mysql:8.0
    hostname: flask-api-mysql
    environment:
      MYSQL_ROOT_PASSWORD: root_password
      MYSQL_DATABASE: flask_app
      MYSQL_USER: flask_user
      MYSQL_PASSWORD: flask_password
    volumes:
      - ./docker/database/mysql:/var/lib/mysql
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    hostname: flask-api-redis
    command: redis-server --requirepass redis_password
    volumes:
      - ./docker/database/redis:/data
    restart: unless-stopped
